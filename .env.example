# GitODS 环境配置示例：复制为 .env 并按环境填写，真实密钥不入版本库。

# 生产必填密钥；开发可留空（自动使用不安全开发密钥）
SECRET_KEY=

# Django 调试模式：生产必须 False
DEBUG=True

# 数据库连接（示例指向本地开发 PG；复用已有容器时改成对应主机端口）
DATABASE_URL=postgres://gitods_app:gitods-dev-local@127.0.0.1:5433/gitods

# 允许的主机、CSRF 信任来源与站点对外地址（生产填实际域名）
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_ORIGIN=http://127.0.0.1:8000

# 私有数据目录（不可变对象 + 临时文件 + 文件锁）；生产建议 /data/gitods
DATA_ROOT=./var/data

# 可调限制（默认值见 config/settings.py GITODS_LIMITS）
# GITODS_MAX_BRANCHES_PER_PROJECT=20
# GITODS_IMPORT_DRAFT_TTL_MINUTES=30
# GITODS_LOGIN_FAIL_LIMIT=5
# GITODS_LOGIN_FAIL_WINDOW_MINUTES=15
# LOG_LEVEL=INFO

# 仅供 compose.dev.yaml 使用（本机复用现有 PG 容器时不需要）
POSTGRES_DB=gitods
POSTGRES_USER=gitods_app
POSTGRES_PASSWORD=change-me
