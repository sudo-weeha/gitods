# GitODS 反向代理：自动 HTTPS（ACME），请求体上限 64 MiB
# （给 50 MiB 业务上限留 multipart 开销；应用仍按实际字节计数限制）。
{
	servers {
		request_body {
			max_size 64MB
		}
	}
}

{$GITODS_DOMAIN} {
	encode gzip

	# /data/gitods 永不作为静态目录公开；一切流量进应用
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
