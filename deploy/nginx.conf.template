# GitODS 反向代理（HTTP，由官方镜像 envsubst 渲染 GITODS_DOMAIN）。
# 本地演练与"TLS 由外部负载均衡终结"的场景使用此模板；
# 生产直接上 HTTPS 请改挂 nginx-tls.conf.template（见 docs/operations.md）。
server {
    listen 80;
    listen 80 [::]:80;
    server_name ${GITODS_DOMAIN} _;

    # 请求体上限 64 MiB：给 50 MiB 业务上限留 multipart 开销，
    # 应用内仍按实际读入字节执行单文件/批次/解压限制
    client_max_body_size 64m;

    gzip on;
    gzip_types text/plain text/css text/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # /data/gitods 永不作为静态目录公开；一切流量进应用
    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
